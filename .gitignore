# .gitignore — временные и производные файлы проекта spevosdk
#
# Принцип: игнорируем мусор ОС/редактора, кэш Python-тулчейна, промежуточные
# результаты сборки и финальные сборочные артефакты. В конце файла ЯВНО
# возвращаем в индекс предсобранные бинарники вендорного SDK `evosdk/`,
# которые нужны для таргета ATM/Evo.

# ── Мусор ОС / редакторов ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
*~
*.swp
*.swo
*.bak
.vscode/
.idea/

# ── Python-тулчейн ассетов (resgen.py / assetpack.py и т.п.) ───────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/

# ── Сборочные scratch-каталоги ────────────────────────────────────────
_temp_/        # scratch старого .bat-пайплайна (Evo)
_build/        # каталог make-сборки (Sprinter)
build/
obj/
out/

# ── Промежуточные файлы компилятора/линкера (SDCC, sjasmplus, sdld) ────
*.ihx
*.rel
*.o
*.lst
*.sym
*.map
*.lk
*.noi
*.rst
*.cdb
*.adb
*.dump
*.lst.*

# ── Сгенерированные ресурсные артефакты ───────────────────────────────
# resources.h создаётся тулом из объявлений ресурсов на каждой сборке.
# Если в каком-то проекте его нужно зафиксировать — снять игнор точечно.
resources.h

# ── Финальные выходы сборки (образы дисков / EXE / банки ассетов) ──────
*.scl
*.exe
*.bin
disk.dat
assets.dat

# ── ВЕНДОРНЫЕ файлы EvoSDK — НЕ игнорировать (нужны для таргета ATM/Evo) ─
# Предсобранные тулы, объектные файлы и бинарники из дистрибутива SDK.
!evosdk/**/*.exe
!evosdk/**/*.o
!evosdk/*.bin
!evosdk/startup.h
!evosdk/ENV.DAT
!evosdk/NOTAS.DAT
*/_build/*
